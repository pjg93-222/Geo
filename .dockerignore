# Only what the hosted image needs. No voter data, no stores, no local state, no tests.
**
!requirements.linux.lock
!manage.py
!server/**
!tools/**
!data/criteria.json
!data/field_dictionary.csv
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/**
!frontend/public/**
!frontend/scripts/copy-ocr-assets.mjs
!frontend/scripts/ocr-LICENSE-tessdata.txt
# Exclusions come last so they win over the inclusions above.
**/__pycache__/**
**/*.pyc
**/test_*.py
**/tests.py
**/*_testkit.py
**/*.test.ts
**/*.ps1
frontend/public/fixtures/**
tools/luna_district/**
**/*.sqlite3
**/*.zip
.local
